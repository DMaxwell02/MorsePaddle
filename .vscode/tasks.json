{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Simulate bouncing paddle",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "morse_paddle",
        "simulate",
        "--text",
        "SOS TEST",
        "--bounce"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "pytest"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}

